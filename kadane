Kadane's Algorithm is used to find the maximum sum of a continuous subarray.

def maxarray(arr):
    current_sum = arr[0]
    max_sum=arr[0]

    for i in range(1,len(arr)):
        current_sum= max(arr[i], current_sum + arr[i])

        max_sum= max(max_sum, current_sum)

    return max_sum
arr=list(map(int,input().split()))
print(maxarray(arr))
