# factorial

def factorial(n):
    if n == 0:
        return 1
    return(n * factorial(n-1))
print(factorial(5))

#print sum of digit

def digit_sum(n):
    if n == 0:
        return 0
    return(n % 10) + digit_sum(n // 10)

print(digit_sum(1234))
