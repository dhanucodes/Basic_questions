#maximum consecutive number

arr = list(map(int, input("Enter array: ").split()))

count = 0
max_count = 0

for num in arr:
    if num == 1:
        count += 1
        max_count = max(max_count, count)
    else:
        count = 0

print("Maximum consecutive 1s:", max_count)

#max with string

s = input("Enter string: ")

count = 1
max_count = 1

for i in range(1, len(s)):
    if s[i] == s[i-1]:
        count += 1
        max_count = max(max_count, count)
    else:
        count = 1

print("Max consecutive characters:", max_count)

#armstrong number

num=int(input())
temp=num
sum_val=0
n=len(str(num))

while temp>0:
    digit=temp%10
    sum_val+=digit**n
    temp=temp//10

if sum_val == num:
    print("yes")
else:
    print("no")

