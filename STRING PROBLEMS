#ANAGRAM WITHOUT SORTING

s1 = input()
s2 = input()

if len(s1) != len(s2):
    print("Not Anagram")
else:
    freq1 = {}
    freq2 = {}

    for ch in s1:
        if ch in freq1:
            freq1[ch] += 1
        else:
            freq1[ch] = 1

    for ch in s2:
        if ch in freq2:
            freq2[ch] += 1
        else:
            freq2[ch] = 1

    if freq1 == freq2:
        print("Anagram")
    else:
        print("Not Anagram")

