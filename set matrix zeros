n=int(input())

matrix=[]

for i in range(n):
    row=list(map(int,input().split()))
    matrix.append(row)

zero_row=set()
zero_col=set()

for i in range(n):
    for j in range(n):
        if matrix[i][j] == 0:
            zero_row.add(i)
            zero_col.add(j)

for i in range(n):
    for j in range(n):
        if i in zero_row or j in zero_col:
            matrix[i][j] = 0

for i in matrix:
    print(*i)
