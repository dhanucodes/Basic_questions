def maxprofit(prices):
    min_price=prices[0]
    max_prices=0

    for i in range(1,len(prices)):
        profit= prices[i] - min_price

        if profit > max_prices:
            max_prices= profit

        if prices[i] < min_price:
            min_price = prices[i]

    return max_prices

prices=list(map(int,input().split())) 
print(maxprofit(prices)) 
