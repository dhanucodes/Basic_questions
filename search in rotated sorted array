arr=list(map(int,input().split()))
target=int(input())

rotated= arr[3:] + arr[:3]

low=0
high=len(rotated)-1

found=False

while low<=high:
    mid=(low+high)//2

    if rotated[mid] == target:
        print(mid)
        found=True
        break
    if rotated[low] <= rotated[mid]:
        if rotated[low] <= target < rotated[mid]:
            high=mid-1
        else:
            low=mid+1
    else:
        if rotated[mid] <= target < rotated[high]:
            low=mid+1
        else:
            high=mid-1
print(rotated)          
if not found:
    print("not found")
