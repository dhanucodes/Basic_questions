arr=list(map(int,input().split()))

def quick_sort(arr):
    if len(arr) <= 1:
        return arr
    pivot=arr[-1]

    left=[]
    right=[]

    for num in arr[:-1]:
        if num > pivot:
            right.append(num)
        else:
            left.append(num)
    return quick_sort(left) + [pivot] + quick_sort(right)
print(quick_sort(arr))
